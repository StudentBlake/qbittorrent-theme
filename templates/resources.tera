---
whiskers:
  version: ^2.4.0
  matrix:
    - flavor
  filename: "src/catppuccin-{{ flavor.identifier }}/resources.qrc"
---
<!DOCTYPE RCC><RCC version="1.0">
	<qresource>
		<file>stylesheet.qss</file>
		<file>config.json</file>

    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/checkbox_checked.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/checkbox_unchecked.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/checkbox_indeterminate.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/check.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/arrow_down.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/arrow_down_disabled.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/chevron_up.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/chevron_up_disabled.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/chevron_down.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/chevron_down_disabled.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/branch_open.svg</file>
    <file>../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/branch_closed.svg</file>

    {# qBittorrent loads GUI icons from :/uitheme/icons/<id>.svg and :/uitheme/icons/dark/<id>.svg #}
    {%- set gui_icons = [
      "application-exit", "application-rss", "application-url", "browser-cookies",
      "chart-line", "checked-completed", "configure", "connected", "dialog-warning",
      "directory", "disconnected", "download", "downloading", "edit-clear", "edit-copy",
      "edit-find", "edit-rename", "error", "fileicon", "filter-active", "filter-all",
      "filter-inactive", "filter-stalled", "firewalled", "folder-documents", "folder-new",
      "folder-remote", "force-recheck", "go-bottom", "go-down", "go-top", "go-up", "hash",
      "help-about", "help-contents", "insert-link", "ip-blocked", "list-add", "list-remove",
      "loading", "mail-inbox", "name", "network-connect", "network-server", "object-locked",
      "pause-session", "paused", "peers", "peers-add", "peers-remove", "plugins",
      "preferences-advanced", "preferences-bittorrent", "preferences-desktop",
      "preferences-webui", "queued", "ratio", "reannounce", "rss_read_article",
      "rss_unread_article", "security-high", "security-low", "set-location", "slow",
      "slow_off", "speedometer", "stalledDL", "stalledUP", "stopped", "system-log-out",
      "tags", "task-complete", "task-reject", "torrent-creator", "torrent-magnet",
      "torrent-start", "torrent-start-forced", "torrent-stop", "tracker-error",
      "tracker-warning", "trackerless", "trackers", "upload", "view-categories",
      "view-preview", "view-refresh", "view-statistics", "wallet-open"
    ] -%}
    {%- for icon in gui_icons %}
    <file alias="icons/{{ icon }}.svg">../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/{{ icon }}.svg</file>
    <file alias="icons/dark/{{ icon }}.svg">../icons/{{ if(cond=flavor.dark, t="dark", f="light") }}/{{ icon }}.svg</file>
    {%- endfor %}
  </qresource>
</RCC>
